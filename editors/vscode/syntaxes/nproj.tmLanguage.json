{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nitride project",
  "scopeName": "source.nproj",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#statements"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nproj",
          "match": "//.*$"
        },
        {
          "name": "comment.block.nproj",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "statements": {
      "comment": "A keyword only opens a statement; the rest of it (names, paths such as languages/grammar) is not keywords.",
      "patterns": [
        {
          "begin": "\\b(workspace|language|nitrogen)\\b",
          "beginCaptures": {
            "1": {
              "name": "storage.type.nproj"
            }
          },
          "end": "(?=[;{}])",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        },
        {
          "begin": "\\b(include|extensions|grammar|start|catalog|binding|trivia|namespace|source|library|version)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.nproj"
            }
          },
          "end": "(?=[;{}])",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    }
  }
}
