{
  "name": "nitride",
  "displayName": "Nitride DSL",
  "description": ".ngr grammars, .ncatalog catalogs and nitride.json/nitrogen.json workspace languages through nitride lsp.",
  "version": "0.1.0",
  "publisher": "nitride",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:nitride.json",
    "workspaceContains:nitrogen.json"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ngr",
        "aliases": [
          "Nitrogen grammar"
        ],
        "extensions": [
          ".ngr"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ncatalog",
        "aliases": [
          "Nitride catalog"
        ],
        "extensions": [
          ".ncatalog"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ngr",
        "scopeName": "source.ngr",
        "path": "./syntaxes/ngr.tmLanguage.json"
      },
      {
        "language": "ncatalog",
        "scopeName": "source.ncatalog",
        "path": "./syntaxes/ncatalog.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Nitride",
      "properties": {
        "nitride.server.path": {
          "type": "string",
          "default": "",
          "description": "The nitride executable (runs `nitride lsp`); empty runs the server bundled with the extension, else nitride from PATH."
        }
      }
    },
