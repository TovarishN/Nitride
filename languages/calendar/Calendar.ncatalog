// Calendar arithmetic is an interface: the host supplies an implementation,
// and the examples decide whether it conforms. Dates are day numbers since
// 0001-01-01, durations are days.
catalog module Calendar
{
  type Date;
  type Duration;

  failure InvalidDate "not a calendar date";
  failure OutOfRange "date out of range";

  interface Gregorian version 1
  {
    operation ParseDate(Text) : Date fails InvalidDate;
    operation Later(Date, Duration) : Date fails OutOfRange;
    operation Earlier(Date, Duration) : Date fails OutOfRange;
    operation Between(Date, Date) : Duration;

    example Later(ParseDate("2024-01-01"), Days(3)) == ParseDate("2024-01-04");
    example Between(ParseDate("2024-03-01"), ParseDate("2024-02-01")) == Days(29);
    example Earlier(ParseDate("2025-01-01"), Days(365)) == ParseDate("2024-01-02");
    example ParseDate("2024-02-30") fails InvalidDate;
    example Earlier(ParseDate("0001-01-01"), Days(1)) fails OutOfRange;
  }

  operation Days(Scalar) : Duration = host identity;
  operation InDays(Duration) : Scalar = host identity;
  operation AddScalar(Scalar, Scalar) : Scalar = host add;
  operation AddDurations(Duration, Duration) : Duration = host add;
  operation SubScalar(Scalar, Scalar) : Scalar = host sub;
  operation SubDurations(Duration, Duration) : Duration = host sub;

  overload Plus = AddScalar | Later | AddDurations;
  overload Minus = SubScalar | Earlier | Between | SubDurations;

  let Let(Value) infer;
  show Show(Value);
}
