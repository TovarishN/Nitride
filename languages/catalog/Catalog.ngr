// Nitride catalogs, the semantic contract between a grammar and its host,
// described in itself. Names are resolved and lowered by nitride-prepare.
syntax module NitrideCatalog
{
  token IdStart = ['a'..'z' 'A'..'Z' '_'];
  token IdPart = ['a'..'z' 'A'..'Z' '0'..'9' '_'];
  token Identifier = IdStart IdPart*;
  token QualifiedName = Identifier ("." Identifier)*;
  // Host handler and predicate names, such as `iso-date`.
  token HandlerName = Identifier ("-" Identifier)*;
  token Hex = ['0'..'9' 'a'..'f' 'A'..'F'];
  token Escape = "\\" (['n' 'r' 't' '0' '\\' '"' '\''] / "u" Hex Hex Hex Hex);
  token String = "\"" (Escape / [^ '"' '\\' '\n'])* "\"";
  token Digit = ['0'..'9'];
  token Number = "-"? Digit+ ("." Digit+)?;
  token Boolean = "true" / "false";

  syntax File = Modules:Module*;
  syntax Module = "catalog" "module" Name:QualifiedName "{" Members:Member* "}";
  syntax Member = Using / Type / Failure / Interface / Operation / Overload / Builtin / Let / Show / Call / Check;
  syntax Using = "using" Name:QualifiedName ";";
  // Values of a type are f64 unless it says how they are represented, or
  // that they are records or lists.
  syntax Type = "type" Name:Identifier Representation:Representation? ";";
  syntax Representation = "=" Shape:(Represented / Record / List);
  syntax Represented = "represented" Kind:Identifier;
  syntax Record = "record" "{" Fields:RecordField* "}";
  syntax RecordField = Name:Identifier ":" Type:QualifiedName ";";
  syntax List = "list" "of" Element:QualifiedName;
  syntax Failure = "failure" Name:Identifier Message:String ";";
  // Operations a binding implements together, and examples every binding must satisfy.
  syntax Interface = "interface" Name:Identifier "version" Version:Number "{" Members:InterfaceMember* "}";
  syntax InterfaceMember = Contract / Example;
  syntax Contract = "operation" Name:Identifier "(" Inputs:(QualifiedName; ",")* ")" ":" Result:QualifiedName Fails:Fails? ";";
  syntax Fails = "fails" Failures:(QualifiedName; ",")+;
  syntax Example = "example" Value:ExampleExpr Outcome:(Equals / Raises) ";";
  syntax Equals = "==" Expected:ExampleExpr;
  syntax Raises = "fails" Failure:QualifiedName;
  syntax ExampleExpr = ExampleCall / ExampleNumber / ExampleBoolean / ExampleText;
  syntax ExampleCall = Operation:QualifiedName "(" Args:(ExampleExpr; ",")* ")";
  syntax ExampleNumber = Value:Number;
  syntax ExampleBoolean = Value:Boolean;
  syntax ExampleText = Value:String;
  syntax Operation = "operation" Name:Identifier "(" Inputs:(QualifiedName; ",")* ")" ":" Result:QualifiedName "=" Provider:(Handler / FieldOf / Structure) ";";
  syntax Handler = "host" Name:HandlerName;
  // The engine's record and list operations.
  syntax FieldOf = "field" Name:Identifier;
  syntax Structure = Kind:StructureKind;
  token StructureKind = "record" / "list" / "length" / "item";
  syntax Overload = "overload" Name:Identifier "=" Candidates:(QualifiedName; "|")+ ";";
  // A callable built-in names its candidate operations; a value has a type and a handler.
  syntax Builtin = "builtin" Kind:Identifier Name:QualifiedName Body:(BuiltinValue / BuiltinCall) ";";
  syntax BuiltinValue = ":" Type:QualifiedName "=" Handler:Handler;
  syntax BuiltinCall = "=" Candidates:(QualifiedName; "|")+;
  syntax Let = "let" Rule:QualifiedName "(" Field:Identifier ")" Infer:Infer? ";";
  syntax Infer = "infer";
  syntax Show = "show" Rule:QualifiedName "(" Field:Identifier ")" ";";
  syntax Call = "call" Rule:QualifiedName "(" Args:(Identifier; ",")* ")" ";";
  // `Rule.Field`: the last segment is the field.
  syntax Check = "check" Target:QualifiedName "is" Predicate:HandlerName "else" Code:Identifier Message:String ";";
}
