// Declarative Rust input for a DateCalc-shaped profile. The catalog supplies
// built-in value types, text-literal checks and overload groups; the
// development-only .NET reference is generated separately.
syntax module Dates
{
  symbols { value }
  builtin value { pi today }
  token Digit = ['0'..'9'];
  token Date = Digit Digit Digit Digit "-" Digit Digit "-" Digit Digit;
  token Number = Digit+ ("." Digit+)?;
  token Identifier = ['a'..'z' 'A'..'Z' '_'] ['a'..'z' 'A'..'Z' '0'..'9' '_']* except "let" "days" "in";
  syntax Program = Statements:Statement*;
  syntax Statement = Let / Show;
  syntax Let = "let" Name:Identifier "=" Value:Expr ";" declares value Name sequential;
  syntax Show = Value:Expr ";";
  extensible syntax Expr
  {
    | Day = Value:Date lowers Dates.ParseDate(text Value)
    | Num = Value:Number lowers literal Core.Scalar Value
    | Ref = Name:Identifier references value Name
    | Paren = "(" Inner:Expr ")"
    | Days = Amount:Expr "days" precedence 30 lowers Dates.Days(Amount)
    | InDays = Span:Expr "in" "days" precedence 5 lowers Dates.InDays(Span)
    | Add = Left:Expr "+" Right:Expr precedence 10 left lowers Dates.Plus(Left, Right)
    | Sub = Left:Expr "-" Right:Expr precedence 10 left lowers Dates.Minus(Left, Right)
    | Mul = Left:Expr "*" Right:Expr precedence 20 left lowers Dates.Times(Left, Right)
  }
}
