syntax module Portable
{
  symbols { value }
  token Number = ['0'..'9']+ ("." ['0'..'9']+)?;
  token Identifier = ['a'..'z' 'A'..'Z' '_'] ['a'..'z' 'A'..'Z' '0'..'9' '_']* except "let" "duration";
  syntax Program = Statements:Statement*;
  syntax Statement = Let / Show;
  syntax Let = "let" Name:Identifier ":" Annotation:Identifier "=" Value:Expr ";" declares value Name sequential type Annotation;
  syntax Show = Value:Expr ";";
  extensible syntax Expr
  {
    | Num = Value:Number lowers literal Core.Scalar Value
    | Ref = Name:Identifier references value Name
    | Paren = "(" Inner:Expr ")"
    | Duration = "duration" "(" Amount:Expr ")" lowers Portable.Duration(Amount)
    | Neg = "-" Value:Expr precedence 30 lowers Portable.Neg(Value)
    | Add = Left:Expr "+" Right:Expr precedence 10 left lowers Portable.Add(Left, Right)
    | Sub = Left:Expr "-" Right:Expr precedence 10 left lowers Portable.Sub(Left, Right)
    | Mul = Left:Expr "*" Right:Expr precedence 20 left lowers Portable.Mul(Left, Right)
    | Div = Left:Expr "/" Right:Expr precedence 20 left lowers Portable.Div(Left, Right)
  }
}
