// JSON (RFC 8259) syntax. Nitride's fixed trivia also skips Unicode
// whitespace and C-style comments between tokens, which strict JSON forbids.
syntax module Json
{
  token Hex = ['0'..'9' 'a'..'f' 'A'..'F'];
  token String = "\"" ([^ '"' '\\' '\u0000'..'\u001f'] / "\\" (['"' '\\' '/' 'b' 'f' 'n' 'r' 't'] / "u" Hex Hex Hex Hex))* "\"";
  token Number = "-"? ("0" / ['1'..'9'] ['0'..'9']*) ("." ['0'..'9']+)? (['e' 'E'] ['+' '-']? ['0'..'9']+)?;

  syntax Document = Root:Value;
  syntax Value = Object / Array / String / Number / "true" / "false" / "null";
  syntax Object = "{" (Members:Member ("," Members:Member)*)? "}";
  syntax Member = Key:String ":" Value:Value;
  syntax Array = "[" (Items:Value ("," Items:Value)*)? "]";
}
