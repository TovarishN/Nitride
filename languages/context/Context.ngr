// Scoped parse context (docs/guides/scoped-parse-context.md): headers set a flag
// that selects which alternative identical words parse as.
syntax module Context
{
  context Enabled;
  syntax File = Items:Item*;
  syntax Item = Async / Ordinary / Reset;
  syntax Async = "a" Body:with(Enabled = true) Expr;
  syntax Ordinary = "n" Body:Expr;
  syntax Reset = "r" "[" Body:with(Enabled = false) Expr "]";
  extensible syntax Expr
  {
    | Enabled = context(Enabled) "x"
    | Disabled = !context(Enabled) "x"
    | Nested = "(" Item ")"
    | Neg = (context(Enabled) "-" Arg:Expr) / (!context(Enabled) "-" Arg:Expr) precedence 20
    | Add = Expr "+" Right:with(Enabled = true) Expr precedence 10 left
  }
}
