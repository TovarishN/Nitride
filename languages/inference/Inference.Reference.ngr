// Generated by scripts/inference_adapter.py; development reference only.
// Declarative Rust input. The catalog explicitly supplies initializer inference
// and overload groups; the development-only .NET reference is generated separately.
syntax module Inference
{
  symbols { value rate }
  symbol property Type for (value | rate) : Nitrogen.Semantic.SemanticType? = null;
  token Number = ['0'..'9']+ ("." ['0'..'9']+)?;
  token Identifier = ['a'..'z' 'A'..'Z' '_'] ['a'..'z' 'A'..'Z' '0'..'9' '_']* except "let" "rate" "value" "either" "reverse" "duration";
  syntax Program = Statements:Statement*;
  syntax Statement = LetValue / LetRate / InferValue / InferRate / Show;
  syntax LetValue = "let" Name:Identifier ":" Annotation:Identifier "=" Value:Expr ";" declares value Name sequential type Annotation { symbol.Type = InferenceLanguage.Resolve(Annotation.Text); }
  syntax LetRate = "rate" Name:Identifier ":" Annotation:Identifier "=" Value:Expr ";" declares rate Name sequential type Annotation { symbol.Type = InferenceLanguage.Resolve(Annotation.Text); }
  syntax InferValue = "let" Name:Identifier "=" Value:Expr ";" declares value Name sequential { symbol.Type = Value.Type; }
  syntax InferRate = "rate" Name:Identifier "=" Value:Expr ";" declares rate Name sequential { symbol.Type = Value.Type; }
  syntax Show = Value:Expr ";";
  extensible syntax Expr
  {
    out Type : Nitrogen.Semantic.SemanticType? = null;
    out Selected : Nitrogen.Semantic.OperationSignature? = null;
    | Num = Value:Number lowers literal Core.Scalar Value { Type = InferenceLanguage.Scalar; }
    | ValueRef = "value" "(" Name:Identifier ")" references value Name lowers reference type Type { Type = Symbol?.Type; }
    | RateRef = "rate" "(" Name:Identifier ")" references rate Name lowers reference type Type { Type = Symbol?.Type; }
    | AnyRef = "either" "(" Name:Identifier ")" references (value | rate) Name lowers reference type Type { Type = Symbol?.Type; }
    | ReverseRef = "reverse" "(" Name:Identifier ")" references (rate | value) Name lowers reference type Type { Type = Symbol?.Type; }
    | Paren = "(" Inner:Expr ")" { Type = Inner.Type; }
    | Duration = "duration" "(" Amount:Expr ")" lowers Inference.Duration(Amount) { Type = InferenceLanguage.Time; }
    | Add = Left:Expr "+" Right:Expr precedence 10 left lowers operation? Selected(Left, Right)
      {
        Selected = InferenceLanguage.Select("Inference.Add", Left.Type, Right.Type);
        Type = Selected?.Result;
        check INF0001 Selected != null : "no exact overload";
      }
    | Sub = Left:Expr "-" Right:Expr precedence 10 left lowers operation? Selected(Left, Right)
      {
        Selected = InferenceLanguage.Select("Inference.Sub", Left.Type, Right.Type);
        Type = Selected?.Result;
        check INF0001 Selected != null : "no exact overload";
      }
  }
}
