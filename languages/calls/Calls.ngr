syntax module Calls
{
  symbols { value function }
  builtin function { neg sum duration zero sys.neg calc }
  token Number = ['0'..'9']+;
  token Identifier = ['a'..'z' 'A'..'Z' '_'] ['a'..'z' 'A'..'Z' '0'..'9' '_' '.']* except "let" "function" "call" "fallback";
  syntax Program = Statements:Statement*;
  syntax Statement = Let / Local / Show;
  syntax Let = "let" Name:Identifier "=" Value:Expr ";" declares value Name sequential;
  syntax Local = "function" Name:Identifier "=" Value:Expr ";" declares function Name sequential;
  syntax Show = Value:Expr ";";
  extensible syntax Expr
  {
    | Num = Value:Number lowers literal Core.Scalar Value
    | Ref = Name:Identifier references value Name
    | Paren = "(" Inner:Expr ")"
    | Call0 = Function:Identifier "(" ")" references function Function
    | Call1 = Function:Identifier "(" Arg:Expr ")" references function Function
    | Call2 = Function:Identifier "(" Left:Expr "," Right:Expr ")" references function Function
    | AnyCall = "call" Function:Identifier "(" Arg:Expr ")" references (function | value) Function
    | FallbackCall = "fallback" Function:Identifier "(" Arg:Expr ")" references (value | function) Function
  }
}
