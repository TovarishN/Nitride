// Admitted Nitride grammar syntax, described in itself. The Rust decoder retains
// literal validation and profile admission; this is not the full Nitrogen.ngr.
syntax module NitrideGrammar
{
  token IdStart = ['a'..'z' 'A'..'Z' '_'];
  token IdPart = ['a'..'z' 'A'..'Z' '0'..'9' '_'];
  token Identifier = IdStart IdPart*;
  token QualifiedName = Identifier ("." Identifier)*;
  token Integer = ['0'..'9']+;
  token Hex = ['0'..'9' 'a'..'f' 'A'..'F'];
  token Escape = "\\" (['n' 'r' 't' '0' '\\' '"' '\''] / "u" Hex Hex Hex Hex);
  token String = "\"" (Escape / [^ '"' '\\' '\n'])* "\"";
  token Char = "'" (Escape / [^ '\'' '\\' '\n']) "'";
  token CallHead = QualifiedName "(";
  token NameTail = IdPart / "." IdStart;
  token Reserved = ("precedence" / "except" / "then" / "else" / "declares" / "references" / "scope" / "dynamic" / "lowers" / "rewrites") !NameTail;
  token LoweringKeyword = ("literal" / "template" / "expand") !NameTail;
  token TextKeyword = "text" !NameTail;
  token TransparentKeyword = "transparent" !NameTail;
  token Comment = "//" [^ '\n']* / "/*" (!"*/" .)* "*/";
  token OpaqueCharLiteral = "'" (Escape / [^ '\'' '\\' '\n'])* "'";
  token OpaqueChar = !("/*" / "//" / "@\"" / "\"\"\"") [^ '{' '}' '"' '\''];
  token Opaque = "{" (!("@\"" / "\"\"\"") (Comment / String / OpaqueCharLiteral / Opaque / OpaqueChar))* "}";
  token QuoteText = "<[" (!"]>" .)* "]>";

  syntax File = Modules:Module*;
  syntax Module = "syntax" "module" Name:QualifiedName "{" Members:Member* "}";
  syntax Member = Using / Symbols / SymbolProperty / Builtin / Helper / Function / TokenRule / SyntaxRule / ExtensibleRule / Extend;
  syntax Using = "using" Name:QualifiedName ";";
  syntax Symbols = "symbols" "{" Names:Identifier+ "}";
  // Nitrogen's C# semantic members. They are recognised so that tolerant
  // preparation can skip them with a diagnostic; they are never admitted.
  syntax SymbolProperty = "symbol" "property" Name:Identifier "for" Kinds:Kinds ":" Type:CsType "=" Default:CsCode ";";
  syntax PropertyDecl = Direction:PropertyDirection Flags:PropertyFlag* Name:Identifier ":" Type:CsType "=" Default:CsCode ";";
  token PropertyDirection = ("out" / "in") !NameTail;
  token PropertyFlag = ("hover" / "expected") !NameTail;
  token CsEsc = "\\" .;
  token CsString = ("$@" / "@$" / "@") "\"" ("\"\"" / [^ '"'])* "\"" / "$"? "\"" (CsEsc / [^ '"' '\\' '\n'])* "\"";
  token CsChar = "'" (CsEsc / [^ '\'' '\\' '\n'])+ "'";
  token CsComment = "//" [^ '\n']* / "/*" (!"*/" .)* "*/";
  token CsNested = "(" CsInner* ")" / "[" CsInner* "]" / "{" CsInner* "}";
  token CsInner = CsString / CsChar / CsComment / CsNested / [^ '(' ')' '[' ']' '{' '}' '"' '\''];
  token CsCode = (CsString / CsChar / CsComment / CsNested / [^ '(' ')' '[' ']' '{' '}' '"' '\'' ';'])+;
  token CsType = (CsString / CsChar / CsComment / CsNested / [^ '(' ')' '[' ']' '{' '}' '"' '\'' ';' '='])+;
  syntax Builtin = "builtin" Kind:Identifier "{" Names:QualifiedName+ "}";
  syntax Helper = "syntax"? "function" Name:Identifier "(" Parameters:(Parameter; ",")* ")" ":" Result:QualifiedName "=" Body:HelperBody ";";
  syntax Parameter = Name:Identifier ":" Category:QualifiedName List:ListMarker?;
  syntax ListMarker = "*";
  syntax HelperBody = MatchBody / QuoteBody;
  syntax QuoteBody = Text:QuoteText;
  syntax MatchBody = "match" Selector:Identifier "{" Arms:Arm* "}";
  syntax Arm = "|" Form:(Fallback / PatternArm);
  syntax Fallback = "_" "=>" Result:QuoteText ";";
  syntax PatternArm = Captures:Captures? Pattern:QuoteText "=>" Result:QuoteText ";";
  syntax Captures = "(" Items:(Parameter; ",")* ")";
  // Grammar functions, evaluated when the grammar is prepared (spec: grammar functions).
  syntax Function = "syntax"? "function" Name:Identifier "(" Parameters:(Parameter; ",")* ")" ":" Result:QualifiedName "=" Lets:Let* Body:Expression ";";
  syntax Let = "let" Name:Identifier "=" Value:Value ";";
  syntax TokenRule = "token" Name:Identifier "=" Body:Expression Except:ExceptList? ";";
  syntax ExceptList = "except" Words:String+;
  syntax SyntaxRule = "syntax" Name:Identifier "=" Body:Expression Clauses:Clause* End:End;
  syntax End = Semantics / Terminator;
  syntax Terminator = ";";
  syntax Semantics = Body:Opaque;
  syntax ExtensibleRule = "extensible" "syntax" Name:Identifier "{" Properties:PropertyDecl* Alternatives:Alternative* "}";
  syntax Extend = "extend" "syntax" Name:QualifiedName "{" Alternatives:Alternative* "}";
  syntax Alternative = "|" Transparent:TransparentMarker? Named:AlternativeName? Body:Expression Precedence:Precedence? Clauses:Clause* Semantics:Semantics?;
  syntax AlternativeName = Name:Identifier "=";
  // `transparent` is the marker only when a name or an element follows it.
  syntax TransparentMarker = TransparentKeyword &(AlternativeName / Element);
  syntax Precedence = "precedence" Level:Integer Associativity:Associativity?;
  syntax Associativity = "left" / "right";

  syntax Expression = Items:Sequence ("/" Items:Sequence)*;
  syntax Sequence = Items:Element (!Reserved Items:Element)*;
  syntax Element = Labelled / Unary;
  syntax Labelled = Name:Identifier ":" Inner:Unary;
  syntax Unary = Predicate / Postfixed;
  syntax Predicate = Op:PredicateOp Inner:Unary;
  syntax PredicateOp = "!" / "&";
  syntax Postfixed = Inner:Primary Ops:Postfix*;
  syntax Postfix = "?" / "*" / "+";
  syntax Primary = Literal / FunctionCall / If / Comprehension / Reference / Any / EmptyGroup / Group / Class;
  syntax Literal = Value:String;
  syntax Reference = !Reserved !CallHead Name:QualifiedName;
  syntax Any = !".." ".";
  syntax FunctionCall = Head:CallHead Args:(Value; ",")* ")";
  syntax If = "if" Condition:Value "then" Then:Expression "else" Else:Expression;
  syntax Comprehension = Kind:ComprehensionKind Variable:Identifier "in" From:Value To:RangeEnd? Block:Block;
  token ComprehensionKind = ("choice" / "seq") !NameTail;
  syntax RangeEnd = ".." Value:Value;
  syntax Block = "{" Lets:Let* Where:Where? Body:Expression "}";
  syntax Where = "where" Condition:Value ":";
  syntax EmptyGroup = "(" ")";
  syntax Group = "(" Inner:Expression Separator:Separator? ")";
  syntax Separator = ";" Value:Expression;
  syntax Class = "[" Negated:Negation? Ranges:Range+ "]";
  syntax Negation = "^";
  syntax Range = Low:Bound High:Upper?;
  syntax Upper = ".." Value:Bound;
  syntax Bound = CharValue / GroupValue / CallValue / NameValue;

  // Value expressions, loosest first: if, or, and, not, comparison, |, &, + -, * / %, ^ (right), unary - ~.
  syntax Value = IfValue / OrValue;
  syntax IfValue = "if" Condition:Value "then" Then:Value "else" Else:Value;
  syntax OrValue = Items:AndValue ("or" Items:AndValue)*;
  syntax AndValue = Items:NotValue ("and" Items:NotValue)*;
  syntax NotValue = NotApplied / CompareValue;
  syntax NotApplied = "not" Operand:NotValue;
  syntax CompareValue = Left:BitOrValue Tail:CompareTail?;
  syntax CompareTail = Op:CompareOp Right:BitOrValue;
  token CompareOp = "==" / "!=" / "<=" / ">=" / "<" / ">";
  syntax BitOrValue = Items:BitAndValue ("|" Items:BitAndValue)*;
  syntax BitAndValue = Items:AddValue ("&" Items:AddValue)*;
  syntax AddValue = First:MulValue Rest:AddTail*;
  syntax AddTail = Op:AddOp Item:MulValue;
  token AddOp = "+" / "-";
  syntax MulValue = First:PowValue Rest:MulTail*;
  syntax MulTail = Op:MulOp Item:PowValue;
  token MulOp = "*" / "/" / "%";
  syntax PowValue = Base:UnaryValue Exponent:PowTail?;
  syntax PowTail = "^" Value:PowValue;
  syntax UnaryValue = UnaryApplied / AtomValue;
  syntax UnaryApplied = Op:UnaryOp Operand:UnaryValue;
  token UnaryOp = "-" / "~";
  syntax AtomValue = IntValue / CharValue / TextValue / ClassValue / BlockValue / GroupValue / CallValue / NameValue;
  syntax IntValue = Value:Integer;
  syntax CharValue = Value:Char;
  syntax TextValue = Value:String;
  syntax ClassValue = "[" Negated:Negation? Ranges:Range* "]";
  syntax BlockValue = Body:Block;
  syntax GroupValue = "(" Inner:Value ")";
  syntax CallValue = Head:CallHead Args:(Value; ",")* ")";
  syntax NameValue = !ValueWord Name:QualifiedName;
  token ValueWord = ("or" / "and" / "not" / "if" / "then" / "else") !NameTail;

  syntax Clause = Declares / References / Scope / Lowers / Rewrites;
  syntax Declares = "declares" Kind:Identifier Field:Identifier Sequential:Sequential? Export:Export? Type:DeclaredType?;
  syntax Sequential = "sequential";
  syntax Export = "export";
  syntax DeclaredType = "type" Name:QualifiedName;
  syntax References = "references" Kinds:Kinds Field:Identifier;
  syntax Kinds = KindGroup / SingleKind;
  syntax KindGroup = "(" Names:(Word; "|")+ ")";
  syntax SingleKind = Name:Identifier;
  syntax Word = Name:Identifier;
  syntax Scope = "scope";
  syntax Lowers = "lowers" Form:(Template / Expand / LiteralLowering / SemanticLowering / Call);
  // Lowerings computed by Nitrogen's C# properties; recognised only to be skipped.
  syntax SemanticLowering = ReferenceLowering / ComputedCall / ValueLowering;
  syntax ReferenceLowering = "reference" "type" Property:Identifier Initializer:InitializerSpec?;
  syntax InitializerSpec = "initializer" Name:Identifier;
  syntax ComputedCall = "operation" Question:Question? Property:Identifier "(" Args:(Argument; ",")* ")";
  syntax Question = "?";
  syntax ValueLowering = "value" "type" Property:Identifier Field:Identifier;
  syntax Template = "template" Field:Identifier "(" Args:Identifier ")";
  syntax Expand = "expand" Field:Identifier "(" Args:Identifier ")";
  syntax LiteralLowering = "literal" Target:QualifiedName Field:Identifier;
  syntax Rewrites = "rewrites" Form:(QuoteBody / HelperCall);
  syntax HelperCall = Target:QualifiedName "(" Args:(Word; ",")* ")";
  syntax Call = !LoweringKeyword Target:QualifiedName "(" Args:(Argument; ",")* ")";
  syntax Argument = TextArgument / Word;
  syntax TextArgument = TextKeyword Name:Identifier;
}
