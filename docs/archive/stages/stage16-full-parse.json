tderr});dest.write_text(json.dumps(report,indent=2)+'\\n');raise RuntimeError('profiler failed')\n   sample=json.loads(run.stdout);assert sample['parse']['allocation_instrumented'] is False\n   samples.append(sample)\n  seconds=statistics.median(s['parse']['elapsed_ns'] for s in samples)/1e9\n  old_seconds=statistics.median(s['parse']['elapsed_ns'] for s in previous['cold'])/1e9\n  row={'size_target':size,'pattern':pattern,'source_sha256':digest,'samples':samples,'median_seconds':seconds,'previous_shared_seconds':old_seconds,'speedup':old_seconds/seconds,'legacy_flat_seconds':reference['nitride_legacy_median_ns']/1e9,'roslyn_seconds':reference['roslyn_cold_median_ns']/1e9,'roslyn_ratio':seconds/(reference['roslyn_cold_median_ns']/1e9)}\n  report['measurements'].append(row);dest.write_text(json.dumps(report,indent=2)+'\\n');print(json.dumps({k:v for k,v in row.items() if k!='samples'}),flush=True)\nassert source_digest()==report['source_sha256']\nsource=damaged(generated(16777216),'one');path.write_text(source)\ncandidates=[];at=source.find('return x * 2')\nwhile at>=0:candidates.append(at+11);at=source.find('return x * 2',at+1)\nat=candidates[len(candidates)//10]\nconfig=Path('/tmp/nitride-predictive-first-edit-config.json');config.write_text(json.dumps({'recover':True,'validate':True,'retain':8,'edits':[{'range':[at,at+1],'replacement':'3'}]}))\nrun=subprocess.run([str(exe),'--edits','csharp4',str(path),str(config)],capture_output=True,text=True)\nassert run.returncode==0,run.stderr\nfirst=json.loads(run.stdout);first['source_sha256']=report['source_sha256'];first['profiler_sha256']=report['profiler_sha256'];(root/'docs/stage16-first-edit.json').write_text(json.dumps(first,indent=2)+'\\n')\nassert first['edits'][0]['equivalent'] is True\nprint('FIRST EDIT',first['edits'][0]['phase']['elapsed_ns']/1e6,first['edits'][0]['snapshot']['stats'],flush=True)\nreport['complete']=True;report['controller_source']=Path(__file__).read_text();dest.write_text(json.dumps(report,in