]/seconds,'original_shared_seconds':old['original_shared_seconds'],'total_speedup':old['original_shared_seconds']/seconds,'roslyn_seconds':old['roslyn_seconds'],'roslyn_ratio':seconds/old['roslyn_seconds']};report['measurements'].append(row);out.write_text(json.dumps(report,indent=2)+'\\n');print(json.dumps({k:v for k,v in row.items() if k!='samples'}),flush=True)\nassert source_digest()==report['source_sha256']\nsource=damaged(generated(16777216),'one');path.write_text(source);at=source.find('return x * 2');candidates=[]\nwhile at>=0:candidates.append(at+11);at=source.find('return x * 2',at+1)\nat=candidates[len(candidates)//10];config=Path('/tmp/nitride-native-first-config.json');config.write_text(json.dumps({'recover':True,'validate':True,'retain':8,'edits':[{'range':[at,at+1],'replacement':'3'}]}))\np=subprocess.run([str(exe),'--native-lexers','--edits','csharp4',str(path),str(config)],capture_output=True,text=True);assert p.returncode==0,p.stderr\nfirst=json.loads(p.stdout);assert first['edits'][0]['equivalent'] is True and first['compiled_lexers'];first.update({k:report[k] for k in ('source_sha256','profiler_sha256')});(root/'docs/stage18-first-edit.json').write_text(json.dumps(first,indent=2)+'\\n')\nreport['complete']=True;report['executable_bytes']=exe.stat().st_size;report['stage17_executable_bytes']=(space/'profile-before').stat().st_size\nf=max(glob.glob('target/release/build/nitride-cli-*/out/csharp4.rs'),key=os.path.getmtime);s=Path(f).read_text();report['generated_csharp_bytes']=len(s.encode());report['generated_scanners']=s.count('fn nitride_lex_');report['controller_source']=Path(__file__).read_text();out.write_text(json.dumps(report,indent=2)+'\\n');assert source_digest()==report['source_sha256'];print('capture complete, edit ms',first['edits'][0]['phase']['elapsed_ns']/1e6,'cold damaged seconds',first['cold']['phase']['elapsed_ns']/1e9,flush=True)\n"
