  "controller_source": "import sys,json,subprocess,statistics,hashlib\nfrom pathlib import Path\nsys.path.insert(0,'scripts');from shared_subtrees import source_digest\nfrom csharp4_scaling import generated\nw=Path('.superpowers/sdd/2026-10-26-native-lexers');exe=w/'profile-final';before=w/'profile-before';out=Path('docs/stage18-paired.json');assert not out.exists()\nreport={'source_sha256':source_digest(),'profiler_sha256':hashlib.sha256(exe.read_bytes()).hexdigest(),'before_profiler_sha256':hashlib.sha256(before.read_bytes()).hexdigest(),'protocol':'Three fresh processes per backend per size, alternating order each round; native flag on final exe versus frozen Stage17 exe; allocator metrics disabled. Run after all other captures/builds.','measurements':[]}\nfor size in [262144,4194304,16777216]:\n p=Path('/tmp/nitride-native-paired.cs');p.write_text(generated(size));samples={'stage17':[],'native':[]}\n for run in range(3):\n  for backend in (['stage17','native'] if run%2==0 else ['native','stage17']):\n   cmd=[str((exe if backend=='native' else before).resolve())]+(['--native-lexers'] if backend=='native' else [])+['--snapshot','csharp4',str(p)]\n   r=subprocess.run(cmd,capture_output=True,text=True);assert r.returncode==0,r.stderr;x=json.loads(r.stdout);assert x['diagnostics']==0 and not x['parse']['allocation_instrumented'];samples[backend].append(x)\n medians={k:statistics.median(s['parse']['elapsed_ns'] for s in v)/1e9 for k,v in samples.items()};row={'size_target':size,'source_sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'samples':samples,'median_seconds':medians,'speedup':medians['stage17']/medians['native']};report['measurements'].append(row);out.write_text(json.dumps(report,indent=2)+'\\n');print(size,medians,row['speedup'],flush=True)\nassert source_digest()==report['source_sha256'];report['complete']=True;report['controller_source']=Path(__file__).read_text();out.write_text(json.dumps(report,indent=2)+'\\n')\n"
}
