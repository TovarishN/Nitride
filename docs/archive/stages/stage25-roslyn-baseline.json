  "roslyn_harness_source": "using System.Diagnostics;\nusing System.Text.Json;\nusing Microsoft.CodeAnalysis;\nusing Microsoft.CodeAnalysis.CSharp;\nvar source = File.ReadAllText(args[0]);\nvar options = new CSharpParseOptions(LanguageVersion.CSharp4);\nvar warmups = int.Parse(args[1]);\nvar runs = int.Parse(args[2]);\nfor (int i=0; i<warmups; i++) { var warm=CSharpSyntaxTree.ParseText(source,options); GC.KeepAlive(warm.GetRoot()); }\nvar samples = new List<object>();\nfor (int i=0; i<runs; i++) {\n var clock=Stopwatch.StartNew();\n var tree=CSharpSyntaxTree.ParseText(source,options);\n var root=tree.GetRoot();\n clock.Stop();\n var elapsed=(long)clock.Elapsed.TotalNanoseconds;\n var errors=tree.GetDiagnostics().Count(d=>d.Severity==DiagnosticSeverity.Error);\n samples.Add(new {elapsed_ns=elapsed, errors, source_length=root.FullSpan.Length});\n GC.KeepAlive(root); GC.KeepAlive(tree);\n}\nConsole.WriteLine(JsonSerializer.Serialize(new {roslyn_version=typeof(CSharpSyntaxTree).Assembly.GetName().Version!.ToString(),runtime=System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription, samples}));\n",
