  "controller_source": "from pathlib import Path\nimport sys,json,hashlib,subprocess,statistics,datetime,platform\nsys.path.insert(0,'scripts');from shared_subtrees import source_digest\nfrom csharp4_scaling import generated\nw=Path('.superpowers/sdd/2026-10-26-predictive-alternatives');b=json.loads((w/'baseline.json').read_text());dll=(w/'roslyn-bench/Bench.dll').resolve();exe=(w/'profile-stage24').resolve();out=Path('docs/stage25-roslyn-baseline.json');assert not out.exists();assert source_digest()==b['source_sha256']\nr={'measured_at_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'host':platform.platform(),'nitride_source_sha256':b['source_sha256'],'nitride_profiler_sha256':b['profiler_sha256'],'roslyn_harness_source':(w/'roslyn-source.cs').read_text(),'roslyn_artifacts':{p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in dll.parent.iterdir() if p.is_file()},'protocol':'Three fresh-process full parses per backend per size, alternating order, same generated valid CSharp4 inputs. Nitride Stage24 --native-syntax --snapshot uninstrumented Release, Roslyn CSharpSyntaxTree.ParseText+GetRoot. Separate Roslyn process per size:3 warmups then5 measured full parses. Source I/O, process startup, Roslyn option construction, post-parse validation and serialization excluded. Nitride includes SourceText, dispatch preparation, shared syntax and dependency index. Different syntax representations. No instrumentation/builds/tests concurrent with timing.','measurements':[]}\nprior=json.loads(Path('docs/stage24-paired.json').read_text())\nfor size in [262144,4194304,16777216]:\n p=Path('/tmp/nitride-alt-input.cs');p.write_text(generated(size));sha=hashlib.sha256(p.read_bytes()).hexdigest();assert sha==next(x for x in prior['measurements'] if x['size_target']==size)['source_sha256'];samples={'nitride':[],'roslyn':[]};row={'size_target':size,'source_sha256':sha,'samples':samples};r['measurements'].append(row)\n for run in range(3):\n  for k in ['nitride','roslyn'] if run%2==0 else ['roslyn','nitride']:\n   cmd=[str(exe),'--native-syntax','--snapshot','csharp4',str(p)] if k=='nitride' else ['dotnet',str(dll),str(p),'0','1'];q=subprocess.run(cmd,capture_output=True,text=True);assert q.returncode==0,q.stderr;x=json.loads(q.stdout)\n   if k=='nitride':assert x['diagnostics']==0 and x['parse']['allocation_instrumented'] is False\n   else:assert x['samples'][0]['errors']==0 and x['samples'][0]['source_length']==p.stat().st_size\n   samples[k].append(x);out.write_text(json.dumps(r,indent=2)+'\\n')\n med={k:statistics.median(x['parse']['elapsed_ns'] if k=='nitride' else x['samples'][0]['elapsed_ns'] for x in a)/1e9 for k,a in samples.items()};row['median_seconds']=med;row['nitride_over_roslyn']=med['nitride']/med['roslyn'];q=subprocess.run(['dotnet',str(dll),str(p),'3','5'],capture_output=True,text=True);assert q.returncode==0,q.stderr;row['roslyn_warm']=json.loads(q.stdout);assert all(x['errors']==0 for x in row['roslyn_warm']['samples']);row['roslyn_warm_median_seconds']=statistics.median(x['elapsed_ns'] for x in row['roslyn_warm']['samples'])/1e9;out.write_text(json.dumps(r,indent=2)+'\\n');print(size,med,row['nitride_over_roslyn'],'warm',row['roslyn_warm_median_seconds'],flush=True)\nassert source_digest()==b['source_sha256'];r['complete']=True;r['controller_source']=Path(__file__).read_text();out.write_text(json.dumps(r,indent=2)+'\\n');print('Roslyn baseline complete',flush=True)\n"
}
