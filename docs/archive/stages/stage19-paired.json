  "controller_source": "import json,sys,hashlib,statistics,subprocess\nfrom pathlib import Path\nsys.path.insert(0,'scripts');from shared_subtrees import source_digest\nfrom csharp4_scaling import generated\nw=Path('.superpowers/sdd/2026-10-26-generated-syntax');exe=w/'profile-final';before=w/'profile-before';out=Path('docs/stage19-paired.json');assert not out.exists()\nr={'source_sha256':source_digest(),'profiler_sha256':hashlib.sha256(exe.read_bytes()).hexdigest(),'before_profiler_sha256':hashlib.sha256(before.read_bytes()).hexdigest(),'protocol':'Three fresh processes per backend per size, alternating order each round. Frozen Stage18 --native-lexers versus corrected final --native-syntax; allocator disabled, no concurrent builds/tests/captures.','measurements':[]}\nfor size in [262144,4194304,16777216]:\n p=Path('/tmp/nitride-syntax-paired.cs');p.write_text(generated(size));samples={'stage18':[],'generated_syntax':[]}\n for run in range(3):\n  for backend in ['stage18','generated_syntax'] if run%2==0 else ['generated_syntax','stage18']:\n   cmd=[str((exe if backend=='generated_syntax' else before).resolve()),'--native-syntax' if backend=='generated_syntax' else '--native-lexers','--snapshot','csharp4',str(p)];o=subprocess.run(cmd,capture_output=True,text=True);assert o.returncode==0,o.stderr;s=json.loads(o.stdout);assert s['diagnostics']==0 and not s['parse']['allocation_instrumented'];samples[backend].append(s)\n medians={k:statistics.median(x['parse']['elapsed_ns'] for x in v)/1e9 for k,v in samples.items()};row={'size_target':size,'source_sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'samples':samples,'median_seconds':medians,'speedup':medians['stage18']/medians['generated_syntax']};r['measurements'].append(row);out.write_text(json.dumps(r,indent=2)+'\\n');print(size,medians,row['speedup'],flush=True)\nassert r['source_sha256']==source_digest();r['complete']=True;r['controller_source']=Path(__file__).read_text();out.write_text(json.dumps(r,indent=2)+'\\n')\n"
