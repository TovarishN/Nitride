  "controller_source": "import sys,json,subprocess,hashlib,statistics,datetime\nfrom pathlib import Path\nroot=Path.cwd();sys.path.insert(0,str(root/'scripts'))\nfrom csharp4_scaling import generated\nfrom recovery_scaling import damaged\nfrom shared_subtrees import source_digest\nexe=root/'.superpowers/sdd/2026-10-26-choice-dispatch/profile-final'\nbefore=json.loads((root/'docs/stage16-full-parse.json').read_text());first_before=json.loads((root/'docs/stage16-first-edit.json').read_text())\nreport={'source_sha256':source_digest(),'profiler_sha256':hashlib.sha256(exe.read_bytes()).hexdigest(),'measured_at_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'protocol':'Three fresh-process valid full parses per size; allocator instrumentation disabled. Elapsed includes cold preparation/source/syntax/index. Prior verified Stage16 and Roslyn captures are same-host preceding reports, not interleaved. Recovery probe accounting is unchanged; first recovered edit independently validated.','measurements':[],'failures':[]}\nout=root/'docs/stage17-full-parse.json';assert not out.exists();path=Path('/tmp/nitride-choice-input.cs')\nfor size in (262144,4194304,16777216):\n source=generated(size);path.write_text(source);old=next(x for x in before['measurements'] if x['size_target']==size and x['pattern']=='strict');digest=hashlib.sha256(source.encode()).hexdigest();assert digest==old['source_sha256']\n samples=[]\n for _ in range(3):\n  run=subprocess.run([str(exe),'--snapshot','csharp4',str(path)],capture_output=True,text=True)\n  if run.returncode:report['failures'].append({'size':size,'status':run.returncode,'stderr':run.stderr});out.write_text(json.dumps(report,indent=2)+'\\n');raise RuntimeError('profiler failed')\n  r=json.loads(run.stdout);assert r['parse']['allocation_instrumented'] is False and r['diagnostics']==0;samples.append(r)\n seconds=statistics.median(s['parse']['elapsed_ns'] for s in samples)/1e9\n row={'size_target':size,'source_sha256':digest,'samples':samples,'median_seconds':seconds,'stage16_seconds':old['median_seconds'],'stage16_speedup':old['median_seconds']/seconds,'original_shared_seconds':old['previous_shared_seconds'],'total_speedup':old['previous_shared_seconds']/seconds,'legacy_flat_seconds':old['legacy_flat_seconds'],'roslyn_seconds':old['roslyn_seconds'],'roslyn_ratio':seconds/old['roslyn_seconds']}\n report['measurements'].append(row);out.write_text(json.dumps(report,indent=2)+'\\n');print(json.dumps({k:v for k,v in row.items() if k!='samples'}),flush=True)\nassert source_digest()==report['source_sha256']\nsource=damaged(generated(16777216),'one');path.write_text(source);candidates=[];at=source.find('return x * 2')\nwhile at>=0:candidates.append(at+11);at=source.find('return x * 2',at+1)\nat=candidates[len(candidates)//10];config=Path('/tmp/nitride-choice-first-edit-config.json');config.write_text(json.dumps({'recover':True,'validate':True,'retain':8,'edits':[{'range':[at,at+1],'replacement':'3'}]}))\nrun=subprocess.run([str(exe),'--edits','csharp4',str(path),str(config)],capture_output=True,text=True);assert run.returncode==0,run.stderr\nfirst=json.loads(run.stdout);assert first['edits'][0]['equivalent'] is True;first['source_sha256']=report['source_sha256'];first['profiler_sha256']=report['profiler_sha256'];(root/'docs/stage17-first-edit.json').write_text(json.dumps(first,indent=2)+'\\n')\nprint('FIRST EDIT',first['edits'][0]['phase']['elapsed_ns']/1e6,first['edits'][0]['snapshot']['stats'],flush=True)\nreport['complete']=True;report['controller_source']=Path(__file__).read_text();out.write_text(json.dumps(report,indent=2)+'\\n');print('CAPTURE COMPLETE',flush=True)\n"
