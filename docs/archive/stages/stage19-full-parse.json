s['parse']['elapsed_ns'] for s in samples)/1e9\n row={'size_target':size,'source_sha256':sha,'samples':samples,'median_seconds':seconds,'stage18_seconds':old['median_seconds'],'stage18_speedup':old['median_seconds']/seconds,'original_shared_seconds':old['original_shared_seconds'],'total_speedup':old['original_shared_seconds']/seconds,'roslyn_seconds':old['roslyn_seconds'],'roslyn_ratio':seconds/old['roslyn_seconds']};r['measurements'].append(row);out.write_text(json.dumps(r,indent=2)+'\\n');print(json.dumps({k:v for k,v in row.items() if k!='samples'}),flush=True)\nassert source_digest()==r['source_sha256']\nsource=damaged(generated(16777216),'one');path.write_text(source);positions=[];at=source.find('return x * 2')\nwhile at>=0:positions.append(at+11);at=source.find('return x * 2',at+1)\nat=positions[len(positions)//10];config=Path('/tmp/nitride-syntax-first-config.json');config.write_text(json.dumps({'recover':True,'validate':True,'retain':8,'edits':[{'range':[at,at+1],'replacement':'3'}]}))\np=subprocess.run([str(exe),'--native-syntax','--edits','csharp4',str(path),str(config)],capture_output=True,text=True);assert p.returncode==0,p.stderr\nf=json.loads(p.stdout);assert f['edits'][0]['equivalent'] and f['compiled_syntax'];f.update({k:r[k] for k in ['source_sha256','profiler_sha256']});(root/'docs/stage19-first-edit.json').write_text(json.dumps(f,indent=2)+'\\n')\nr['complete']=True;r['executable_bytes']=exe.stat().st_size;r['stage18_executable_bytes']=(w/'profile-before').stat().st_size\nfile=max(glob.glob('target/release/build/nitride-cli-*/out/csharp4.rs'),key=os.path.getmtime);s=Path(file).read_text();r['generated_csharp_bytes']=len(s.encode());r['generated_body_functions']=s.count('fn nitride_syntax_');r['generated_tail_functions']=s.count('fn nitride_tail_');r['generated_lexical_functions']=s.count('fn nitride_lex_');r['controller_source']=Path(__file__).read_text();out.write_text(json.dumps(r,indent=2)+'\\n');assert source_digest()==r['source_sha256'];print